<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="MageSuite_FileAttachments::config_attachment" title="File Attachments Configuration"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="MageSuite_FileAttachments::attachment" title="Manage File Attachments" translate="title" sortOrder="10">
                    <resource id="MageSuite_FileAttachments::attachment_view" title="View File Attachments" translate="title" sortOrder="10"/>
                    <resource id="MageSuite_FileAttachments::attachment_save" title="Save File Attachments" translate="title" sortOrder="20"/>
                    <resource id="MageSuite_FileAttachments::attachment_delete" title="Delete File Attachments" translate="title" sortOrder="30"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
