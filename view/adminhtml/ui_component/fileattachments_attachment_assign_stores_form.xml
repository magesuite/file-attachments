<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">fileattachments_attachment_assign_stores_form.fileattachments_attachment_assign_stores_form_data_source</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <deps>
            <dep>fileattachments_attachment_assign_stores_form.fileattachments_attachment_assign_stores_form_data_source</dep>
        </deps>
        <dataScope>data</dataScope>
        <namespace>fileattachments_attachment_assign_stores_form</namespace>
        <buttons>
            <button name="back" class="MageSuite\FileAttachments\Block\Adminhtml\Attachment\MassAssignStores\BackButton"/>
            <button name="save" class="MageSuite\FileAttachments\Block\Adminhtml\Attachment\MassAssignStores\AssignButton"/>
        </buttons>
    </settings>
    <dataSource name="fileattachments_attachment_assign_stores_form_data_source" component="Magento_Ui/js/form/provider">
        <settings>
            <submitUrl path="fileattachments/attachment/massAssignStoresSave"/>
        </settings>
        <dataProvider class="MageSuite\FileAttachments\Ui\DataProvider\AssignStoresDataProvider" name="fileattachments_attachment_assign_stores_form_data_source">
            <settings>
                <requestFieldName>attachment_id</requestFieldName>
                <primaryFieldName>attachment_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <collapsible>false</collapsible>
            <opened>true</opened>
            <label translate="true">Store View Assignment</label>
        </settings>
        <field name="attachment_ids" formElement="hidden" class="MageSuite\FileAttachments\Ui\Component\Form\Field\SelectedAttachmentIds" sortOrder="0">
            <settings>
                <dataType>text</dataType>
                <dataScope>attachment_ids</dataScope>
            </settings>
        </field>
        <field name="selected_attachments" formElement="input" class="MageSuite\FileAttachments\Ui\Component\Form\Field\SelectedAttachmentsSummary" sortOrder="5">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Selected Attachments</label>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <dataScope>selected_attachments</dataScope>
            </settings>
        </field>
        <field name="mode" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">add</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Assignment Mode</label>
                <dataScope>mode</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageSuite\FileAttachments\Model\Config\Source\StoreAssignmentMode"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="store_ids" formElement="multiselect" class="Magento\Store\Ui\Component\Form\Field\StoreView" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">attachment</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>int</dataType>
                <label translate="true">Store View</label>
                <dataScope>store_ids</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="MageSuite\FileAttachments\Ui\Component\Listing\Column\Attachment\Store"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
    </fieldset>
</form>
